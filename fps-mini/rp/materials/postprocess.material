{
    "weapon_bloom_extract": {
        "vertexShader": "shaders/uv_fullscreen.vertex",
        "fragmentShader": "shaders/glow_extract.fragment",
        "vertexFields": [
            {
                "field": "Position"
            },
            {
                "field": "UV0"
            }
        ],
        "samplerStates": [
            {
                "samplerIndex": 0,
                "textureWrap": "Clamp",
                "textureFilter": "Bilinear"
            }
        ],
        "states": [
            "DisableDepthTest"
        ],
        "msaaSupport": "Both"
    },
