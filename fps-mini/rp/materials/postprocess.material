{
    "scope": {
        "vertexShader": "shaders/uv_fullscreen.vertex",
        "fragmentShader": "shaders/glsl/scope.fragment",
        "vertexFields": [
            {
                "field": "Position"
            },
            {
                "field": "UV0"
            }
        ],
        "samplerStates": [
            {
                "samplerIndex": 0,
                "textureWrap": "Clamp",
                "textureFilter": "Bilinear"
            }
        ],
        "states": [
            "DisableDepthTest"
        ],
        "msaaSupport": "Both"
    },
    "muzzle_flash": {
        "vertexShader": "shaders/uv_fullscreen.vertex",
        "fragmentShader": "shaders/glsl/muzzle_flash.fragment",
        "vertexFields": [
            {
                "field": "Position"
            },
            {
                "field": "UV0"
            }
        ],
        "samplerStates": [
            {
                "samplerIndex": 0,
                "textureWrap": "Clamp",
                "textureFilter": "Bilinear"
            },
            {
                "samplerIndex": 1,
                "textureWrap": "Clamp",
                "textureFilter": "Point"
            },
            {
                "samplerIndex": 2,
                "textureWrap": "Clamp",
                "textureFilter": "Point"
            }
        ],
        "states": [
            "DisableDepthTest"
        ],
        "msaaSupport": "Both"
    }
}