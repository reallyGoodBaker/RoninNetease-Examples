{
    "format_version": "1.12.0",
    "render_controllers": {
        "controller.render.template.weapon": {
            "geometry": "geometry.default",
            "textures": [
                "texture.weapon"
            ],
            "materials": [
                {
                    "*": "material.weapon",
                    "glow*": "material.glow",
                    "scope_inner": "material.scope",
                    "eyepiece": "material.eyepiece"
                }
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "*arm": false
                },
                {
                    "*sleeve": false
                },
                {
                    "bayonet": "v.attach_bayonet ?? 0"
                }
            ],
            "smooth_normal": false
        },
        "controller.render.first_person.arm": {
            "geometry": "geometry.arms",
            "textures": [
                "texture.default"
            ],
            "materials": [
                {
                    "*": "material.default"
                }
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "*arm": "!q.mod.gunsmith"
                },
                {
                    "*sleeve": "!q.mod.gunsmith"
                }
            ]
        },
        "controller.render.tint.overlay": {
            "geometry": "geometry.default",
            "textures": [
                "texture.tint_mask"
            ],
            "materials": [
                {
                    "*": "material.tint_overlay"
                }
            ],
            "overlay_color": {
                "r": "query.mod.tint_color_r",
                "g": "query.mod.tint_color_g",
                "b": "query.mod.tint_color_b",
                "a": "query.mod.tint_color_a"
            },
            "part_visibility": [
                { "*": true },
                { "*arm": false },
                { "*sleeve": false }
            ]
        },
        "controller.render.no_shadow": {
            "filter_lighting": true,
            "geometry": "geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "texture.default"
            ]
        },
        "controller.render.third_person.torso": {
            "filter_lighting": true,
            "geometry": "geometry.player",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "texture.default"
            ]
        },
        "controller.render.third_person.weapon": {
            "filter_lighting": true,
            "geometry": "geometry.third_model",
            "materials": [
                {
                    "*": "material.weapon",
                    "glow*": "material.glow",
                    "scope_inner": "material.scope",
                    "eyepiece": "material.eyepiece"
                }
            ],
            "textures": [
                "texture.weapon"
            ],
            "overlay_color": {
                "r": "query.mod.tint_color_r",
                "g": "query.mod.tint_color_g",
                "b": "query.mod.tint_color_b",
                "a": "query.mod.tint_color_a"
            },
            "part_visibility": [
                { "*": true },
                { "*arm": false },
                { "*leg": false },
                { "head": false }
            ]
        }
    }
}
