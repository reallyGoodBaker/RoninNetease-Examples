{
    "format_version": "1.12.0",
    "render_controllers": {
        "controller.render.template.weapon": {
            "geometry": "geometry.default",
            "textures": [
                "texture.weapon"
            ],
            "materials": [
                {
                    "*": "material.weapon",
                    "glow*": "material.glow",
                    "scope_inner": "material.scope",
                    "eyepiece": "material.eyepiece"
                }
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "*arm": false
                },
                {
                    "*sleeve": false
                }
            ],
            "smooth_normal": false
        },
        "controller.render.fps.arm": {
            "geometry": "geometry.arms",
            "textures": [
                "texture.default"
            ],
            "materials": [
                {
                    "*": "material.default"
                }
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "*arm": true
                },
                {
                    "*sleeve": true
                }
            ]
        },
        "controller.render.no_shadow": {
            "filter_lighting": true,
            "geometry": "geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "texture.default"
            ]
        }
    }
}
