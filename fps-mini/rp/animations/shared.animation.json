{
    "format_version": "1.8.0",
    "animations": {
        "animation.custom.weapons.root": {
            "loop": "hold_on_last_frame",
            "bones": {
                "fpsroot": {
                    "rotation": [
                        0,
                        "q.mod.is_first_person ? 180 : 0",
                        0
                    ]
                },
                "control": {
                    "rotation": [
                        "q.mod.x_rot",
                        "q.mod.y_rot",
                        0
                    ],
                    "position": [
                        "v.fpbody_px = math.lerp(v.fpbody_px ?? 0, -math.abs(math.cos(q.modified_distance_moved * (q.is_sprinting ? 14 : 12))) * math.clamp(q.modified_move_speed, 0, 1) * (q.is_sprinting ? 0.8 : 0.4), 0.1); return v.fpbody_px * q.mod.walk_scale * (1 - q.mod.is_aiming) + q.mod.control_pos_x;",
                        "v.fpbody_py = math.lerp(v.fpbody_py ?? 0, -math.abs(math.sin(q.modified_distance_moved * (q.is_sprinting ? 28 : 24))) * math.clamp(q.modified_move_speed, 0, 1) * (q.is_sprinting ? 1.2 : 0.8), 0.1); v.breath_y = math.lerp(v.breath_y ?? 0, math.sin(q.life_time * 30), 0.5) * 0.1; return v.fpbody_py * q.mod.walk_scale * (1 - q.mod.is_aiming) + q.mod.control_pos_y + v.breath_y * q.mod.shake_scale;",
                        "v.fpbody_pz = math.lerp(v.fpbody_pz ?? 0,  math.abs(math.cos(q.modified_distance_moved * (q.is_sprinting ? 14 : 12))) * math.clamp(q.modified_move_speed, 0, 1) * (q.is_sprinting ? 0.8 : 0.5), 0.1); return v.fpbody_pz * q.mod.walk_scale * (1 - q.mod.is_aiming) + q.mod.control_pos_z;"
                    ],
                    "scale": [
                        1,
                        1,
                        "q.mod.model_scale"
                    ]
                },
                "crosshair": {
                    "rotation": [
                        "q.mod.c_rot_x",
                        "q.mod.c_rot_y",
                        "q.mod.c_rot_z"
                    ]
                }
            }
        },
        "animation.custom.humanoid.hold": {
            "loop": "hold_on_last_frame",
            "bones": {
                "head": {
                    "relative_to": {
                        "rotation": "entity"
                    },
                    "rotation": [
                        "q.target_x_rotation",
                        "q.target_y_rotation",
                        0
                    ]
                },
                "waist": {
                    "rotation": [
                        "v.waist_rotx = math.lerp(v.waist_rotx ?? 0, q.target_x_rotation * 0.4, 1 - math.exp(-5 * q.delta_time)); return v.waist_rotx;",
                        "q.target_y_rotation * 0.8",
                        0
                    ]
                },
                "leftarm": {
                    "rotation": [
                        "q.target_x_rotation * 0.6",
                        0,
                        0
                    ]
                },
                "rightarm": {
                    "rotation": [
                        "v.right_arm_rot = math.lerp(v.right_arm_rot ?? 0, q.target_x_rotation * 0.6, 1 - math.exp(-25 * q.delta_time)); return v.right_arm_rot;",
                        0,
                        0
                    ]
                }
            }
        },
        "animation.custom.humanoid.aiming": {
            "loop": "hold_on_last_frame",
            "bones": {
                "head": {
                    "rotation": [
                        0, 0, -20
                    ]
                },
                "waist": {
                    "rotation": [
                        "v.waist_rotx = math.lerp(v.waist_rotx ?? 0, q.target_x_rotation * 0.4, 1 - math.exp(-5 * q.delta_time)); return v.waist_rotx;",
                        "q.target_y_rotation",
                        0
                    ]
                },
                "leftarm": {
                    "rotation": [
                        "q.target_x_rotation * 0.6",
                        0,
                        0
                    ]
                },
                "rightarm": {
                    "rotation": [
                        "v.right_arm_rot = math.lerp(v.right_arm_rot ?? 0, q.target_x_rotation * 0.6, 1 - math.exp(-25 * q.delta_time)); return v.right_arm_rot;",
                        0,
                        0
                    ]
                }
            }
        },
        "animation.custom.humanoid.walk": {
            "loop": true,
            "bones": {
                "leftleg": {
                    "rotation": [
                        "variable.tcos0 * -1.4",
                        -0.1,
                        -0.1
                    ]
                },
                "rightleg": {
                    "rotation": [
                        "variable.tcos0 * 1.4",
                        0.1,
                        0.1
                    ]
                }
            }
        },
        "animation.custom.humanoid.riding": {
            "loop": true,
            "bones": {
                "leftarm": {
                    "rotation": [ "-36.0 - this", 0.0, 0.0 ]
                },
                "leftleg": {
                    "rotation": [
                        "-81.0 - this",
                        "-18.0 - this",
                        "-this"
                    ]
                },
                "rightleg": {
                    "rotation": [
                        "-81.0 - this",
                        "18.0 - this",
                        "-this"
                    ]
                }
            }
        }
    }
}