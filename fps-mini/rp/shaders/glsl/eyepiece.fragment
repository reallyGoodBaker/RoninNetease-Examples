// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as appropriate.
precision highp float;

#include "fragmentVersionCentroidUV.h"
#include "uniformEntityConstants.h"
#include "uniformExtraVectorConstants.h"

#ifdef RNGL_LOCAL_LIGHT
varying vec4 worldSpacePos;
varying vec4 worldSpaceNormal;
#endif

void main()
{
    // 相机在原点，视线方向就是 -worldSpacePos
    vec3 V = normalize(-worldSpacePos.xyz);
    vec3 N = normalize(worldSpaceNormal.xyz);

    // 把平面法线改成凸镜法线：越靠近镜片边缘，法线越向外偏
    vec2 lensUV = uv - 0.5;
    vec3 up = abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    float lensCurvature = 0.9;
    vec3 lensN = normalize(N + (T * lensUV.x + B * lensUV.y) * lensCurvature);

    // 先用原始平面法线过滤：15 度以内完全透明，避免凸镜边缘误挡
    float flatAlignment = clamp(abs(dot(N, V)), 0.0, 1.0);
    float flatAngle = acos(flatAlignment) * 57.2957795;
    if (flatAngle <= 15.0) {
        discard;
    }

    // 通过透明过滤后，再用弯折后的凸镜法线计算渐变角度
    float alignment = clamp(abs(dot(lensN, V)), 0.0, 1.0);
    float angle = acos(alignment) * 57.2957795;

    // 完全基于凸镜法线 lensN 做光照，让目镜表面有弧度感
    vec3 sunDir = normalize(SUN_DIR.xyz);
    float dayFactor = mix(0.2, 1.0, SUN_DIR.w); // 白天亮，晚上暗

    // 漫反射：法线越正对太阳越亮
    float diff = max(dot(lensN, sunDir), 0.0);
    vec3 ambientColor = TILE_LIGHT_COLOR.rgb * 0.2;
    vec3 diffuseColor = TILE_LIGHT_COLOR.rgb * diff * dayFactor;

    // 高光：凸镜表面反光
    vec3 H = normalize(sunDir + V);
    float spec = pow(max(dot(lensN, H), 0.0), 24.0) * dayFactor;

    vec3 litColor = ambientColor + diffuseColor * 0.8 + vec3(1.0) * spec * 0.8;

    // 15~30 度：从黑色渐变到光照颜色
    float t = clamp((angle - 15.0) / 15.0, 0.0, 1.0);
    vec3 color = mix(vec3(0.0), litColor, t * 0.6);

    gl_FragColor = vec4(color, 1.0);
}
